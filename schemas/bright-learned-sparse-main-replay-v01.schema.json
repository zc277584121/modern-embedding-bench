{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "cpu_only", "model_loaded", "package_manifest_sha256", "package_protocol_sha256", "input_contract_sha256", "rebuilt_tracked_files_sha256", "local_mapping_sha256", "publication"],
  "properties": {
    "schema_version": {"const": "bright-learned-sparse-main-replay-v1"},
    "status": {"const": "pass"},
    "cpu_only": {"const": true},
    "model_loaded": {"const": false},
    "package_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "package_protocol_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rebuilt_tracked_files_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "local_mapping_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "publication": {"type": "object"}
  }
}
