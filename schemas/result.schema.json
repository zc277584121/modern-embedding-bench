{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark v2 Result Record",
  "$defs": {
    "trainingOverlap": {
      "type": "object",
      "required": [
        "schema_version",
        "relationship_registry_revision",
        "relationship_registry_sha256",
        "data_overlap_status",
        "task_training_status",
        "zero_shot_status",
        "matched_model_ids",
        "matched_training_source_ids",
        "matched_evaluation_source_ids",
        "relationship_ids",
        "reason_codes",
        "assessed_at"
      ],
      "properties": {
        "schema_version": {"const": "1"},
        "relationship_registry_revision": {"type": "string"},
        "relationship_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "model_revision": {"type": ["string", "null"]},
        "model_training_evidence_revision": {"type": ["string", "null"]},
        "task_dataset_version": {"type": ["string", "null"]},
        "task_source_evidence_revision": {"type": ["string", "null"]},
        "data_overlap_status": {"type": "string", "enum": ["exact", "adapted", "declared_none", "unknown"]},
        "task_training_status": {"type": "string", "enum": ["same_task", "similar_task", "declared_none", "unknown"]},
        "zero_shot_status": {"type": "string", "enum": ["no", "reviewed_yes", "unknown"]},
        "matched_model_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "matched_training_source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "matched_evaluation_source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "relationship_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "assessed_at": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "dataSourceContract": {
      "type": "object",
      "required": [
        "schema_version",
        "task_id",
        "dataset_version",
        "manifest_revision",
        "manifest_sha256",
        "data_mode",
        "validation_status",
        "source_ids",
        "transformation_id",
        "row_count",
        "asset_count",
        "reason_codes"
      ],
      "properties": {
        "schema_version": {"const": "1"},
        "task_id": {"type": "string", "minLength": 1},
        "dataset_version": {"type": "string", "minLength": 1},
        "manifest_revision": {"type": ["string", "null"]},
        "manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "data_mode": {"type": "string", "enum": ["real", "fixture", "unknown"]},
        "validation_status": {"type": "string", "enum": ["validated", "fixture", "invalid", "unknown"]},
        "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "transformation_id": {"type": ["string", "null"]},
        "row_count": {"type": ["integer", "null"], "minimum": 0},
        "asset_count": {"type": ["integer", "null"], "minimum": 0},
        "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schema_version", "run", "timestamps", "model", "task", "provider_result", "metrics", "details", "error"],
  "properties": {
    "schema_version": {"type": "string"},
    "training_overlap_contract_version": {"type": "string", "enum": ["1"]},
    "training_overlap": {"$ref": "#/$defs/trainingOverlap"},
    "data_source_contract_version": {"type": "string", "enum": ["1"]},
    "data_source_contract": {"$ref": "#/$defs/dataSourceContract"},
    "run": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "description": {"type": "string"},
        "metadata": {"type": "object"},
        "publish": {"type": "boolean", "default": true},
        "evidence_tier": {
          "type": "string",
          "enum": ["legacy", "smoke", "benchmark", "fixture", "unknown"]
        },
        "git_sha": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "timestamps": {"type": "object"},
    "model": {"type": "object"},
    "task": {"type": "object"},
    "provider_result": {"type": "object"},
    "metrics": {"type": "object"},
    "details": {"type": "object"},
    "error": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {
        "properties": {"training_overlap_contract_version": {"const": "1"}},
        "required": ["training_overlap_contract_version"]
      },
      "then": {"required": ["training_overlap"]}
    },
    {
      "if": {
        "properties": {"data_source_contract_version": {"const": "1"}},
        "required": ["data_source_contract_version"]
      },
      "then": {"required": ["data_source_contract"]}
    }
  ],
  "additionalProperties": true
}
