{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark v2 Result Record",
  "$defs": {
    "nnzStats": {
      "type": "object",
      "required": ["count", "total", "min", "max", "mean"],
      "properties": {
        "count": {"type": "integer", "minimum": 1},
        "total": {"type": "integer", "minimum": 1},
        "min": {"type": "integer", "minimum": 1},
        "max": {"type": "integer", "minimum": 1},
        "mean": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "trainingOverlap": {
      "type": "object",
      "required": [
        "schema_version",
        "relationship_registry_revision",
        "relationship_registry_sha256",
        "data_overlap_status",
        "task_training_status",
        "zero_shot_status",
        "matched_model_ids",
        "matched_training_source_ids",
        "matched_evaluation_source_ids",
        "relationship_ids",
        "reason_codes",
        "assessed_at"
      ],
      "properties": {
        "schema_version": {"const": "1"},
        "relationship_registry_revision": {"type": "string"},
        "relationship_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "model_revision": {"type": ["string", "null"]},
        "model_training_evidence_revision": {"type": ["string", "null"]},
        "task_dataset_version": {"type": ["string", "null"]},
        "task_source_evidence_revision": {"type": ["string", "null"]},
        "data_overlap_status": {"type": "string", "enum": ["exact", "adapted", "declared_none", "unknown"]},
        "task_training_status": {"type": "string", "enum": ["same_task", "similar_task", "declared_none", "unknown"]},
        "zero_shot_status": {"type": "string", "enum": ["no", "reviewed_yes", "unknown"]},
        "matched_model_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "matched_training_source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "matched_evaluation_source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "relationship_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "assessed_at": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "dataSourceContract": {
      "type": "object",
      "required": [
        "schema_version",
        "task_id",
        "dataset_version",
        "manifest_revision",
        "manifest_sha256",
        "data_mode",
        "validation_status",
        "source_ids",
        "transformation_id",
        "row_count",
        "asset_count",
        "reason_codes"
      ],
      "properties": {
        "schema_version": {"const": "1"},
        "task_id": {"type": "string", "minLength": 1},
        "dataset_version": {"type": "string", "minLength": 1},
        "manifest_revision": {"type": ["string", "null"]},
        "manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "data_mode": {"type": "string", "enum": ["real", "fixture", "unknown"]},
        "validation_status": {"type": "string", "enum": ["validated", "fixture", "invalid", "unknown"]},
        "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "transformation_id": {"type": ["string", "null"]},
        "row_count": {"type": ["integer", "null"], "minimum": 0},
        "asset_count": {"type": ["integer", "null"], "minimum": 0},
        "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schema_version", "run", "timestamps", "model", "task", "provider_result", "execution", "metrics", "details", "error"],
  "properties": {
    "schema_version": {"type": "string"},
    "training_overlap_contract_version": {"type": "string", "enum": ["1"]},
    "training_overlap": {"$ref": "#/$defs/trainingOverlap"},
    "data_source_contract_version": {"type": "string", "enum": ["1"]},
    "data_source_contract": {"$ref": "#/$defs/dataSourceContract"},
    "run": {
      "type": "object",
      "properties": {
        "id": {"type": "string"},
        "description": {"type": "string"},
        "metadata": {"type": "object"},
        "publish": {"type": "boolean", "default": true},
        "evidence_tier": {
          "type": "string",
          "enum": ["legacy", "smoke", "benchmark", "fixture", "unknown"]
        },
        "git_sha": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "timestamps": {"type": "object"},
    "model": {"type": "object"},
    "task": {"type": "object"},
    "provider_result": {"type": "object"},
    "execution": {
      "type": "object",
      "properties": {
        "retrieval_kind": {"type": "string", "enum": ["sparse_exact", "multi_vector_exact_maxsim"]},
        "representation_kind": {"type": "string", "enum": ["sparse_csr", "multi_vector"]},
        "provider": {"type": "string"},
        "model_name": {"type": "string"},
        "model_revision": {"type": "string"},
        "representation_id": {"type": "string"},
        "representation_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "vocabulary_id": {"type": "string"},
        "dimensions": {"type": "integer", "minimum": 1},
        "query_route": {"type": "string"},
        "document_route": {"type": "string"},
        "query_nnz": {"$ref": "#/$defs/nnzStats"},
        "document_nnz": {"$ref": "#/$defs/nnzStats"},
        "valid_token_count": {"type": "integer", "minimum": 1},
        "passage_count": {"type": "integer", "minimum": 1},
        "document_count": {"type": "integer", "minimum": 1},
        "aggregation": {"type": "string", "enum": ["max_passage"]},
        "exact_backend": {"type": "string"},
        "exact": {"type": "boolean"},
        "index_bytes_estimate": {"type": "integer", "minimum": 0},
        "encoding_latency_ms": {"type": "number", "minimum": 0},
        "search_latency_ms": {"type": "number", "minimum": 0},
        "peak_memory_bytes": {"type": ["integer", "null"], "minimum": 0},
        "peak_vram_bytes": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "metrics": {"type": "object"},
    "details": {"type": "object"},
    "error": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {
        "properties": {"training_overlap_contract_version": {"const": "1"}},
        "required": ["training_overlap_contract_version"]
      },
      "then": {"required": ["training_overlap"]}
    },
    {
      "if": {
        "properties": {"data_source_contract_version": {"const": "1"}},
        "required": ["data_source_contract_version"]
      },
      "then": {"required": ["data_source_contract"]}
    },
    {
      "if": {
        "properties": {
          "model": {
            "type": "object",
            "properties": {"representation_kind": {"const": "sparse_csr"}},
            "required": ["representation_kind"]
          },
          "error": {"type": "null"}
        },
        "required": ["model", "error"]
      },
      "then": {
        "properties": {
          "execution": {
            "required": [
              "retrieval_kind", "representation_kind", "provider", "model_name", "model_revision",
              "representation_id", "representation_identity", "vocabulary_id", "dimensions", "query_route",
              "document_route", "query_nnz", "document_nnz", "exact_backend", "exact",
              "index_bytes_estimate", "encoding_latency_ms", "search_latency_ms", "peak_memory_bytes",
              "peak_vram_bytes"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "model": {
            "type": "object",
            "properties": {"representation_kind": {"const": "multi_vector"}},
            "required": ["representation_kind"]
          },
          "error": {"type": "null"}
        },
        "required": ["model", "error"]
      },
      "then": {
        "properties": {
          "execution": {
            "required": [
              "retrieval_kind", "representation_kind", "provider", "model_name", "model_revision",
              "representation_id", "representation_identity", "dimensions", "query_route", "document_route",
              "valid_token_count", "passage_count", "document_count", "aggregation", "exact_backend", "exact",
              "index_bytes_estimate", "encoding_latency_ms", "search_latency_ms", "peak_memory_bytes",
              "peak_vram_bytes"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
