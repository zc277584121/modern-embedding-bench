{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modern-embedding-bench.local/schemas/learned-sparse-phase-one-summary-v01.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase_id",
    "story_id",
    "publication",
    "data",
    "quality",
    "anchors",
    "models",
    "slices",
    "cases",
    "system",
    "recommendations",
    "remaining_gaps",
    "derivation"
  ],
  "properties": {
    "schema_version": {"const": "learned-sparse-phase-one-summary-v1"},
    "phase_id": {"const": "learned-sparse-phase-one-v0.1"},
    "story_id": {"const": "S-20260814-011"},
    "publication": {"$ref": "#/$defs/publication"},
    "data": {
      "type": "object",
      "required": ["source", "selection", "scope", "tracks", "governance"],
      "properties": {
        "tracks": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["track", "queries", "documents", "positive_qrels", "qrel_density", "single_positive_queries"],
            "properties": {
              "track": {"enum": ["economics", "psychology"]},
              "queries": {"type": "integer", "minimum": 1},
              "documents": {"const": 7500},
              "positive_qrels": {"type": "integer", "minimum": 1},
              "qrel_density": {"type": "number", "exclusiveMinimum": 0},
              "single_positive_queries": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "quality": {
      "type": "object",
      "required": ["metrics", "models", "tracks", "paired_uncertainty", "track_aggregation"],
      "properties": {
        "metrics": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string"}},
        "models": {"const": 7},
        "track_aggregation": {"const": "none"}
      },
      "additionalProperties": true
    },
    "anchors": {"type": "object"},
    "models": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "object"}},
    "slices": {"type": "object", "required": ["economics", "psychology"]},
    "cases": {"type": "object"},
    "system": {
      "type": "object",
      "required": ["deployment", "coverage", "correctness", "qps", "persisted_index", "boundaries"],
      "properties": {
        "persisted_index": {
          "type": "object",
          "required": ["pairs", "sindi_larger_pairs", "sindi_over_daat_ratio_min", "sindi_over_daat_ratio_max"],
          "properties": {
            "pairs": {"const": 12},
            "sindi_larger_pairs": {"const": 12}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "recommendations": {"type": "array", "minItems": 6, "items": {"type": "object"}},
    "remaining_gaps": {"type": "array", "minItems": 6, "items": {"type": "string"}},
    "derivation": {
      "type": "object",
      "required": ["protocol_sha256", "accepted_inputs_only", "model_loaded", "milvus_connected"],
      "properties": {
        "protocol_sha256": {"$ref": "#/$defs/sha256"},
        "accepted_inputs_only": {"const": true},
        "model_loaded": {"const": false},
        "milvus_connected": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "publication": {
      "type": "object",
      "required": ["classification", "gate", "public_export_allowed", "leaderboard_publish", "contains_source_text", "contains_canonical_ids", "contains_raw_rankings", "contains_private_paths"],
      "properties": {
        "classification": {"const": "research_only"},
        "gate": {"const": "closed"},
        "public_export_allowed": {"const": false},
        "leaderboard_publish": {"const": false},
        "contains_source_text": {"const": false},
        "contains_canonical_ids": {"const": false},
        "contains_raw_rankings": {"const": false},
        "contains_private_paths": {"const": false}
      },
      "additionalProperties": false
    }
  }
}
