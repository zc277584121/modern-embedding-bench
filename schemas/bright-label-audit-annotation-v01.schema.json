{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modern-embedding-bench.local/schemas/bright-label-audit-annotation-v01.schema.json",
  "title": "Restricted BRIGHT label-audit annotation row v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "review_role",
    "track",
    "query_id",
    "input_row_sha256",
    "rubric_sha256",
    "gold_reviews",
    "candidate_reviews",
    "query_review"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "audit_id": {"const": "bright-label-quality-audit-v0.1"},
    "review_role": {"enum": ["primary", "validator"]},
    "track": {"enum": ["economics", "psychology"]},
    "query_id": {"type": "string", "minLength": 1},
    "input_row_sha256": {"$ref": "#/$defs/sha256"},
    "rubric_sha256": {"$ref": "#/$defs/sha256"},
    "gold_reviews": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/goldReview"}
    },
    "candidate_reviews": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidateReview"}
    },
    "query_review": {"$ref": "#/$defs/queryReview"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "confidence": {"enum": ["high", "medium", "low"]},
    "decisionStatus": {"enum": ["decided", "uncertain", "abstain"]},
    "risk": {"enum": ["none", "low", "moderate", "high", "uncertain"]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "judgment_origin",
        "agent_role",
        "provider",
        "model",
        "model_revision",
        "session_id",
        "round",
        "judged_at",
        "rubric_sha256",
        "input_artifact_sha256",
        "input_row_sha256"
      ],
      "properties": {
        "judgment_origin": {"enum": ["agent_judged", "llm_assisted"]},
        "agent_role": {"enum": ["executor_primary", "independent_validator", "validator_adjudicator"]},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "model_revision": {"type": ["string", "null"]},
        "session_id": {"type": "string", "minLength": 1},
        "round": {"type": "integer", "minimum": 1},
        "judged_at": {"type": "string", "format": "date-time"},
        "rubric_sha256": {"$ref": "#/$defs/sha256"},
        "input_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "input_row_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "goldReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "support",
        "ambiguity",
        "confidence",
        "decision_status",
        "notes",
        "provenance"
      ],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "support": {"enum": ["supports", "partially_supports", "does_not_support", "uncertain"]},
        "ambiguity": {"enum": ["unambiguous", "ambiguous", "uncertain"]},
        "confidence": {"$ref": "#/$defs/confidence"},
        "decision_status": {"$ref": "#/$defs/decisionStatus"},
        "notes": {"type": "string"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "candidateReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "relevance",
        "likely_hard_negative",
        "suspected_missing_positive",
        "sensitive_information_risk",
        "sensitive_information_types",
        "confidence",
        "decision_status",
        "notes",
        "provenance"
      ],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "relevance": {"enum": ["relevant", "not_relevant", "uncertain"]},
        "likely_hard_negative": {"enum": ["yes", "no", "uncertain"]},
        "suspected_missing_positive": {"enum": ["credible", "not_credible", "not_applicable", "uncertain"]},
        "sensitive_information_risk": {"$ref": "#/$defs/risk"},
        "sensitive_information_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "personal_contact",
              "public_contact",
              "network_identifier",
              "credential_or_secret",
              "health",
              "financial",
              "legal",
              "minor",
              "reidentification",
              "other"
            ]
          }
        },
        "confidence": {"$ref": "#/$defs/confidence"},
        "decision_status": {"$ref": "#/$defs/decisionStatus"},
        "notes": {"type": "string"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "queryReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credible_missing_positive",
        "credible_missing_positive_ids",
        "likely_hard_negative_present",
        "likely_hard_negative_ids",
        "qrels_completeness",
        "answerability",
        "label_incompleteness_risk",
        "sensitive_information_risk",
        "confidence",
        "decision_status",
        "notes",
        "provenance"
      ],
      "properties": {
        "credible_missing_positive": {"enum": ["yes", "no", "uncertain"]},
        "credible_missing_positive_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "likely_hard_negative_present": {"enum": ["yes", "no", "uncertain"]},
        "likely_hard_negative_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "qrels_completeness": {"enum": ["complete_enough", "incomplete", "uncertain"]},
        "answerability": {"enum": ["answerable", "no_answer", "uncertain"]},
        "label_incompleteness_risk": {"$ref": "#/$defs/risk"},
        "sensitive_information_risk": {"$ref": "#/$defs/risk"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "decision_status": {"$ref": "#/$defs/decisionStatus"},
        "notes": {"type": "string"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    }
  }
}
