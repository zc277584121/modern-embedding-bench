{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BRIGHT Learned Sparse Restricted Failure Cases V1",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "publication": {
      "type": "object",
      "required": ["publish", "leaderboard_publish", "public_export_allowed", "gate", "classification"],
      "properties": {
        "publish": {"const": false},
        "leaderboard_publish": {"const": false},
        "public_export_allowed": {"const": false},
        "gate": {"const": "closed"},
        "classification": {"const": "research_only"}
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": ["ndcg@10", "map@100", "mrr@10", "recall@10", "recall@100"],
      "properties": {
        "ndcg@10": {"type": "number", "minimum": 0, "maximum": 1},
        "map@100": {"type": "number", "minimum": 0, "maximum": 1},
        "mrr@10": {"type": "number", "minimum": 0, "maximum": 1},
        "recall@10": {"type": "number", "minimum": 0, "maximum": 1},
        "recall@100": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema_version", "dataset_version", "publication", "selection_rule",
    "contains_restricted_ids", "contains_source_text", "cases"
  ],
  "properties": {
    "schema_version": {"const": "bright-learned-sparse-failure-cases-v1"},
    "dataset_version": {"const": "bright-nontechnical-pilot-v0.2"},
    "publication": {"$ref": "#/$defs/publication"},
    "selection_rule": {
      "const": "Select the minimum nDCG@10 query in each cell; break metric ties by canonical query ID ascending."
    },
    "contains_restricted_ids": {"const": true},
    "contains_source_text": {"const": false},
    "cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "model_key", "track", "raw_manifest_sha256", "query_id", "metrics",
          "relevant_document_ids", "excluded_document_ids", "hits"
        ],
        "properties": {
          "model_key": {"enum": ["granite-30m-sparse", "opensearch-doc-v2-mini", "opensearch-doc-v3", "bge-m3"]},
          "track": {"enum": ["economics", "psychology"]},
          "raw_manifest_sha256": {"$ref": "#/$defs/sha256"},
          "query_id": {"type": "string", "minLength": 1},
          "metrics": {"$ref": "#/$defs/metrics"},
          "relevant_document_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "excluded_document_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "hits": {
            "type": "array",
            "minItems": 100,
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": ["rank", "document_id", "score"],
              "properties": {
                "rank": {"type": "integer", "minimum": 1, "maximum": 100},
                "document_id": {"type": "string", "minLength": 1},
                "score": {"type": "number", "minimum": 0}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
