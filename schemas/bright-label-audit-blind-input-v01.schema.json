{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modern-embedding-bench.local/schemas/bright-label-audit-blind-input-v01.schema.json",
  "title": "Restricted BRIGHT label-audit blind input row v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "track",
    "query_id",
    "query",
    "source_row_sha256",
    "gold_documents",
    "candidate_documents"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "audit_id": {"const": "bright-label-quality-audit-v0.1"},
    "track": {"enum": ["economics", "psychology"]},
    "query_id": {"type": "string", "minLength": 1},
    "query": {"type": "string", "minLength": 1},
    "source_row_sha256": {"$ref": "#/$defs/sha256"},
    "gold_documents": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/gold"}
    },
    "candidate_documents": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "content", "grade"],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "content": {"type": "string"},
        "grade": {"const": 1}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "content"],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "content": {"type": "string"}
      }
    }
  }
}
