{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark Model Registry",
  "$defs": {
    "publicProvenance": {
      "type": "object",
      "properties": {
        "urls": {"type": "array", "items": {"type": "string"}},
        "evidence_revision": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"]},
        "reviewed_by": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "state": {"type": "string", "enum": ["pending", "approved", "rejected"]},
        "private_notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "sourceClaim": {
      "type": "object",
      "required": ["source_id"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "relation": {"type": "string", "enum": ["trained_on"]},
        "scope": {"type": "string", "enum": ["material_samples"]},
        "source_revision": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "negativeClaim": {
      "type": "object",
      "required": ["source_id"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1, "not": {"const": "*"}},
        "relation": {"type": "string", "enum": ["not_trained_on"]},
        "scope": {"type": "string", "enum": ["material_samples"]},
        "source_revision": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "trainingData": {
      "type": "object",
      "properties": {
        "disclosure": {"type": "string", "enum": ["unknown", "partial", "complete"]},
        "source_claims": {"type": "array", "items": {"$ref": "#/$defs/sourceClaim"}},
        "negative_claims": {"type": "array", "items": {"$ref": "#/$defs/negativeClaim"}},
        "adapted_from": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "lineage_disclosure": {"type": "string", "enum": ["unknown", "complete"]},
        "model_revision": {"type": ["string", "null"]},
        "public_provenance": {"$ref": "#/$defs/publicProvenance"},
        "review": {"$ref": "#/$defs/review"}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["models"],
  "properties": {
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "display_name", "provider"],
        "properties": {
          "id": {"type": "string"},
          "display_name": {"type": "string"},
          "provider": {"type": "string"},
          "provider_kwargs": {"type": "object"},
          "representation_kind": {"type": "string", "enum": ["dense_vector", "sparse_csr", "multi_vector"]},
          "model_revision": {"type": ["string", "null"]},
          "representation_id": {"type": ["string", "null"]},
          "vocabulary_id": {"type": ["string", "null"]},
          "query_route": {"type": ["string", "null"], "enum": ["neural", "static_lookup", "tokenizer_idf", "document_expansion", "query_late_interaction", "none", null]},
          "document_route": {"type": ["string", "null"], "enum": ["neural", "static_lookup", "tokenizer_idf", "document_expansion", "document_late_interaction", "none", null]},
          "modalities": {"type": "array", "items": {"type": "string"}},
          "dimensions": {"type": ["integer", "null"]},
          "max_text_length": {"type": ["integer", "null"]},
          "supports_mrl": {"type": "boolean"},
          "access": {"type": "string"},
          "api_key_env": {"type": ["string", "null"]},
          "status": {"type": "string"},
          "publish": {"type": "boolean"},
          "priority": {"type": "integer"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "source": {"type": ["string", "null"]},
          "notes": {"type": ["string", "null"]},
          "training_data": {"$ref": "#/$defs/trainingData"}
        },
        "allOf": [
          {
            "if": {"properties": {"representation_kind": {"const": "sparse_csr"}}, "required": ["representation_kind"]},
            "then": {
              "required": ["model_revision", "representation_id", "vocabulary_id", "query_route", "document_route", "dimensions"]
            }
          }
          ,{
            "if": {"properties": {"representation_kind": {"const": "multi_vector"}}, "required": ["representation_kind"]},
            "then": {"required": ["model_revision", "representation_id", "query_route", "document_route", "dimensions"]}
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
