{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BRIGHT Learned Sparse Tracked Aggregate V1",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "route": {"enum": ["neural", "static_lookup", "document_expansion"]},
    "publication": {
      "type": "object",
      "required": ["publish", "leaderboard_publish", "public_export_allowed", "gate", "classification"],
      "properties": {
        "publish": {"const": false},
        "leaderboard_publish": {"const": false},
        "public_export_allowed": {"const": false},
        "gate": {"const": "closed"},
        "classification": {"const": "research_only"}
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": ["ndcg@10", "map@100", "mrr@10", "recall@10", "recall@100"],
      "properties": {
        "ndcg@10": {"type": "number", "minimum": 0, "maximum": 1},
        "map@100": {"type": "number", "minimum": 0, "maximum": 1},
        "mrr@10": {"type": "number", "minimum": 0, "maximum": 1},
        "recall@10": {"type": "number", "minimum": 0, "maximum": 1},
        "recall@100": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "interval": {
      "type": "object",
      "required": ["mean", "low", "high", "samples", "seed"],
      "properties": {
        "mean": {"type": "number", "minimum": 0, "maximum": 1},
        "low": {"type": "number", "minimum": 0, "maximum": 1},
        "high": {"type": "number", "minimum": 0, "maximum": 1},
        "samples": {"const": 10000},
        "seed": {"const": 20260826}
      },
      "additionalProperties": false
    },
    "confidenceIntervals": {
      "type": "object",
      "required": ["ndcg@10", "map@100", "mrr@10", "recall@10", "recall@100"],
      "properties": {
        "ndcg@10": {"$ref": "#/$defs/interval"},
        "map@100": {"$ref": "#/$defs/interval"},
        "mrr@10": {"$ref": "#/$defs/interval"},
        "recall@10": {"$ref": "#/$defs/interval"},
        "recall@100": {"$ref": "#/$defs/interval"}
      },
      "additionalProperties": false
    },
    "nnzStats": {
      "type": "object",
      "required": ["count", "total", "mean", "p50", "p95", "max", "empty"],
      "properties": {
        "count": {"type": "integer", "minimum": 1},
        "total": {"type": "integer", "minimum": 0},
        "mean": {"type": "number", "minimum": 0},
        "p50": {"type": "number", "minimum": 0},
        "p95": {"type": "number", "minimum": 0},
        "max": {"type": "integer", "minimum": 0},
        "empty": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "documentAudit": {
      "type": "object",
      "required": [
        "count", "latency_ms", "cpu_time_s", "truncated_count", "max_observed_tokens",
        "peak_ram_bytes", "peak_vram_bytes", "tokenizer_classes", "batch_sizes_used"
      ],
      "properties": {
        "count": {"const": 7500},
        "latency_ms": {"type": "number", "exclusiveMinimum": 0},
        "cpu_time_s": {"type": "number", "exclusiveMinimum": 0},
        "truncated_count": {"type": "integer", "minimum": 0, "maximum": 7500},
        "max_observed_tokens": {"type": "integer", "minimum": 1},
        "peak_ram_bytes": {"type": "integer", "minimum": 1},
        "peak_vram_bytes": {"type": "integer", "minimum": 1, "maximum": 11274289152},
        "tokenizer_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "not": {"const": "unknown"}}},
        "batch_sizes_used": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": [1, 2, 4, 8]}},
        "batch_sizes_attempted": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": [1, 2, 4, 8]}}
      },
      "additionalProperties": false
    },
    "queryAudit": {
      "type": "object",
      "required": [
        "count", "latency_ms", "cpu_time_s", "truncated_count", "max_observed_tokens", "peak_ram_bytes",
        "peak_vram_bytes", "tokenizer_class", "batch_size_requested", "batch_size_used", "pruning_max_active_dims"
      ],
      "properties": {
        "count": {"enum": [101, 103]},
        "latency_ms": {"type": "number", "exclusiveMinimum": 0},
        "cpu_time_s": {"type": "number", "exclusiveMinimum": 0},
        "truncated_count": {"type": "integer", "minimum": 0, "maximum": 103},
        "max_observed_tokens": {"type": "integer", "minimum": 1},
        "peak_ram_bytes": {"type": "integer", "minimum": 1},
        "peak_vram_bytes": {"type": "integer", "minimum": 1, "maximum": 11274289152},
        "tokenizer_class": {"type": "string", "minLength": 1, "not": {"const": "unknown"}},
        "batch_size_requested": {"const": 8},
        "batch_size_used": {"enum": [1, 2, 4, 8]},
        "batch_size_attempts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": [1, 2, 4, 8]}},
        "pruning_max_active_dims": {"type": ["integer", "null"], "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schema_version", "dataset_version", "publication", "cells", "content_policy"],
  "properties": {
    "schema_version": {"const": "bright-learned-sparse-summary-v1"},
    "dataset_version": {"const": "bright-nontechnical-pilot-v0.2"},
    "publication": {"$ref": "#/$defs/publication"},
    "cells": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "model_key", "repo_id", "revision", "license", "mechanism", "query_route", "document_route",
          "training_overlap_boundary", "snapshot_identity_sha256", "track", "counts", "metrics",
          "confidence_intervals", "nnz", "audit", "search"
        ],
        "properties": {
          "model_key": {"enum": ["granite-30m-sparse", "opensearch-doc-v2-mini", "opensearch-doc-v3", "bge-m3"]},
          "repo_id": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
          "revision": {"$ref": "#/$defs/revision"},
          "license": {"enum": ["Apache-2.0", "MIT"]},
          "mechanism": {"type": "string", "minLength": 1},
          "query_route": {"$ref": "#/$defs/route"},
          "document_route": {"$ref": "#/$defs/route"},
          "training_overlap_boundary": {"type": "string", "minLength": 1},
          "snapshot_identity_sha256": {"$ref": "#/$defs/sha256"},
          "track": {"enum": ["economics", "psychology"]},
          "counts": {
            "oneOf": [
              {
                "type": "object",
                "required": ["documents", "queries", "qrels"],
                "properties": {"documents": {"const": 7500}, "queries": {"const": 103}, "qrels": {"const": 800}},
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["documents", "queries", "qrels"],
                "properties": {"documents": {"const": 7500}, "queries": {"const": 101}, "qrels": {"const": 692}},
                "additionalProperties": false
              }
            ]
          },
          "metrics": {"$ref": "#/$defs/metrics"},
          "confidence_intervals": {"$ref": "#/$defs/confidenceIntervals"},
          "nnz": {
            "type": "object",
            "required": ["documents", "queries"],
            "properties": {"documents": {"$ref": "#/$defs/nnzStats"}, "queries": {"$ref": "#/$defs/nnzStats"}},
            "additionalProperties": false
          },
          "audit": {
            "type": "object",
            "required": ["document_chunks", "query", "exact_search_s"],
            "properties": {
              "document_chunks": {"$ref": "#/$defs/documentAudit"},
              "query": {"$ref": "#/$defs/queryAudit"},
              "exact_search_s": {"type": "number", "exclusiveMinimum": 0}
            },
            "additionalProperties": false
          },
          "search": {
            "type": "object",
            "required": ["backend", "exact", "top_k", "tie_break"],
            "properties": {
              "backend": {"const": "scipy_csr_exact"},
              "exact": {"const": true},
              "top_k": {"const": 100},
              "tie_break": {"const": "document_id_ascending"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "content_policy": {"const": "Aggregate-only fields; row-level and source-bearing fields are omitted."}
  },
  "additionalProperties": false
}
