{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark Task Registry",
  "$defs": {
    "publicProvenance": {
      "type": "object",
      "properties": {
        "urls": {"type": "array", "items": {"type": "string"}},
        "evidence_revision": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"]},
        "reviewed_by": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "state": {"type": "string", "enum": ["pending", "approved", "rejected"]},
        "private_notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "evaluationSources": {
      "type": "object",
      "properties": {
        "disclosure": {"type": "string", "enum": ["unknown", "complete"]},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_id"],
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "usage": {"type": "string", "enum": ["evaluation"]},
              "config": {"type": ["string", "null"]},
              "split": {"type": ["string", "null"]},
              "transformation_id": {"type": ["string", "null"]},
              "source_revision": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          }
        },
        "public_provenance": {"$ref": "#/$defs/publicProvenance"},
        "review": {"$ref": "#/$defs/review"}
      },
      "additionalProperties": false
    },
    "materialization": {
      "type": "object",
      "properties": {
        "transformation_parameters": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["tasks"],
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "display_name", "task", "description"],
        "properties": {
          "id": {"type": "string"},
          "display_name": {"type": "string"},
          "task": {"type": "string"},
          "description": {"type": "string"},
          "default_kwargs": {"type": "object"},
          "execution_kind": {"type": "string", "enum": ["dense", "sparse_exact"]},
          "fixture_only": {"type": "boolean"},
          "score_validity": {"type": ["string", "null"], "enum": ["contract_only", null]},
          "required_modalities": {"type": "array", "items": {"type": "string"}},
          "primary_metric": {"type": ["string", "null"]},
          "metric_direction": {"type": "string", "enum": ["higher", "lower"]},
          "dataset_version": {"type": "string"},
          "publish": {"type": "boolean"},
          "leaderboard_publish": {"type": "boolean"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "evaluation_sources": {"$ref": "#/$defs/evaluationSources"},
          "materialization": {"$ref": "#/$defs/materialization"}
        },
        "allOf": [
          {
            "if": {"properties": {"fixture_only": {"const": true}}, "required": ["fixture_only"]},
            "then": {
              "required": ["publish", "leaderboard_publish"],
              "properties": {"publish": {"const": false}, "leaderboard_publish": {"const": false}}
            }
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
